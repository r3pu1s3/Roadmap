// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

model Map {
  id          Int @id @default(autoincrement())
  name        String
  objectives  Objective[]
}

model Objective {
  id          Int    @id @default(autoincrement())
  description String
  isTask   Boolean

  // Optional deadline window for the objective, modeled as a start/end range
  // rather than a single instant. An Objective may have no deadline at all
  // (both columns null). deadlineStart/deadlineEnd are a pair: the service
  // layer (ObjectiveService.parseDeadlines) rejects requests that set exactly
  // one of the two, so in practice they're either both null or both set.
  deadlineStart DateTime?
  deadlineEnd   DateTime?

  mapId    Int
  map   Map @relation(fields: [mapId], references: [id], onDelete: Cascade)

  counter ObjectiveCounter?

  // an Objective can be the "child" side of many edges (multiple parents)...
  incomingEdges ObjectiveEdge[] @relation("ChildSide")
  // ...and the "parent" side of many edges (multiple children)
  outgoingEdges ObjectiveEdge[] @relation("ParentSide")
}

model ObjectiveEdge {
  id       Int @id @default(autoincrement())
  parentId Int
  childId  Int

  parent Objective @relation("ParentSide", fields: [parentId], references: [id], onDelete: Cascade)
  child  Objective @relation("ChildSide", fields: [childId], references: [id], onDelete: Cascade)
  @@unique([parentId, childId])
}

model ObjectiveCounter {
  id             Int       @id @default(autoincrement())
  label          String    // extracted from description's {placeholders}
  targetQuantity Int?
  objectiveId    Int      @unique
  objective      Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, label]) // one counter per unique placeholder name, per objective
}