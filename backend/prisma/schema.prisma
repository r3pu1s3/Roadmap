// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

model Objective {
  id          Int    @id @default(autoincrement())
  description String
  isTask   Boolean

  counter ObjectiveCounter?

  // an Objective can be the "child" side of many edges (multiple parents)...
  incomingEdges ObjectiveEdge[] @relation("ChildSide")
  // ...and the "parent" side of many edges (multiple children)
  outgoingEdges ObjectiveEdge[] @relation("ParentSide")
}

model ObjectiveEdge {
  id       Int @id @default(autoincrement())
  parentId Int
  childId  Int

  parent Objective @relation("ParentSide", fields: [parentId], references: [id], onDelete: Cascade)
  child  Objective @relation("ChildSide", fields: [childId], references: [id], onDelete: Cascade)
  @@unique([parentId, childId])
}

model ObjectiveCounter {
  id             Int       @id @default(autoincrement())
  label          String    // extracted from description's {placeholders}
  targetQuantity Int?
  objectiveId    Int      @unique
  objective      Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, label]) // one counter per unique placeholder name, per objective
}