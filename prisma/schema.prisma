// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

model GoalNode {
  id           Int           @id @default(autoincrement())
  description  String
  parentId     Int?
  rewardRule   Int[]
  deadlineRule Int[]
  completed    Boolean       @default(false)
  deadline     DateTime
  counters     GoalCounter[]

  parent   GoalNode?  @relation("GoalNodeHierarchy", fields: [parentId], references: [id])
  children GoalNode[] @relation("GoalNodeHierarchy")
}

model GoalCounter {
  id             Int      @id @default(autoincrement())
  label          String   // e.g. "pushups"
  targetQuantity Int      // goal amount, e.g. 3
  goalNodeId     Int
  goalNode       GoalNode @relation(fields: [goalNodeId], references: [id])
}